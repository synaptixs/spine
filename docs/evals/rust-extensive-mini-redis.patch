@@ -27,0 +28,9 @@ async fn ping_pong_with_message() {
+#[tokio::test]
+async fn ping_many_preserves_message_order() {
+    let (addr, _) = start_server().await;
+    let mut client = Client::connect(addr).await.unwrap();
+    let messages = vec!["first".into(), "second".into()];
+
+    assert_eq!(client.ping_many(&messages).await.unwrap(), messages);
+}
