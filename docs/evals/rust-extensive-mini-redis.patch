diff --git a/src/clients/client.rs b/src/clients/client.rs
index 741b012..0672dab 100644
--- a/src/clients/client.rs
+++ b/src/clients/client.rs
@@ -124,0 +125,9 @@ impl Client {
+    /// Ping once for each message, preserving the order of the responses.
+    pub async fn ping_many(&mut self, messages: &[Bytes]) -> crate::Result<Vec<Bytes>> {
+        let mut responses = Vec::with_capacity(messages.len());
+        for message in messages {
+            responses.push(self.ping(Some(message.clone())).await?);
+        }
+        Ok(responses)
+    }
+
